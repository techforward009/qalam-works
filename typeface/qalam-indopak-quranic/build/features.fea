languagesystem DFLT dflt;
languagesystem arab dflt;

feature init {
  sub [beh jeem seen sad ain feh qaf kaf lam meem noon heh hehgoal hehdo yeh yehdotless] by [beh_init jeem_init seen_init sad_init ain_init feh_init qaf_init kaf_init lam_init meem_init noon_init heh_init hehgoal_init hehdo_init yeh_init yehdotless_init];
} init;
feature medi {
  sub [beh jeem seen sad ain feh qaf kaf lam meem noon heh hehgoal hehdo yeh yehdotless] by [beh_medi jeem_medi seen_medi sad_medi ain_medi feh_medi qaf_medi kaf_medi lam_medi meem_medi noon_medi heh_medi hehgoal_medi hehdo_medi yeh_medi yehdotless_medi];
} medi;
feature fina {
  sub [beh jeem seen sad ain feh qaf kaf lam meem noon heh hehgoal hehdo yeh yehdotless alef dal reh bariyeh tehgoal] by [beh_fina jeem_fina seen_fina sad_fina ain_fina feh_fina qaf_fina kaf_fina lam_fina meem_fina noon_fina heh_fina hehgoal_fina hehdo_fina yeh_fina yehdotless_fina alef_fina dal_fina reh_fina bariyeh_fina tehgoal_fina];
} fina;

