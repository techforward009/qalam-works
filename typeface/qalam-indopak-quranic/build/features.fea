} medi;
feature fina {
  sub [beh jeem seen sad ain feh qaf kaf lam meem noon heh hehgoal hehdo teh hah dad tah ghain yeh yehdotless alef dal reh bariyeh tehgoal thal waw] by [beh_fina jeem_fina seen_fina sad_fina ain_fina feh_fina qaf_fina kaf_fina lam_fina meem_fina noon_fina heh_fina hehgoal_fina hehdo_fina teh_fina hah_fina dad_fina tah_fina ghain_fina yeh_fina yehdotless_fina alef_fina dal_fina reh_fina bariyeh_fina tehgoal_fina thal_fina waw_fina];
} fina;

