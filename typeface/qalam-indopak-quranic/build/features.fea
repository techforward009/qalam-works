languagesystem DFLT dflt;
languagesystem arab dflt;

feature init {
  sub [beh jeem seen sad ain feh qaf kaf lam meem noon heh hehgoal hehdo teh hah dad tah ghain yeh yehdotless] by [beh_init jeem_init seen_init sad_init ain_init feh_init qaf_init kaf_init lam_init meem_init noon_init heh_init hehgoal_init hehdo_init teh_init hah_init dad_init tah_init ghain_init yeh_init yehdotless_init];
